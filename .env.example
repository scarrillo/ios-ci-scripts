# Copy to your project root and fill in values:
#   cp ci_scripts/.env.example .env

export OP_SERVICE_ACCOUNT_TOKEN=
export OP_ENVIRONMENT_ID=

# distribute.sh — Firebase App Distribution
# App ID: Firebase console -> Project settings -> your iOS app
export FIREBASE_APP_ID=
# Optional comma-separated tester group aliases
export FIREBASE_TESTER_GROUPS=
